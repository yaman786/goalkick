<%- include('header', { title: title, active: 'matches' }) %>

    <div class="page-header">
        <h1 class="page-title">
            <%= isEdit ? '✏️ Edit Match' : '➕ Create Match' %>
        </h1>
        <a href="/admin/matches" class="btn-admin btn-admin-secondary">← Back to Matches</a>
    </div>

    <form action="<%= isEdit ? '/admin/matches/' + match.id : '/admin/matches' %>" method="POST" class="admin-form"
        style="max-width: 700px;">
        <div class="form-row">
            <div class="form-group">
                <label for="team_home">Home Team *</label>
                <input type="text" id="team_home" name="team_home" required value="<%= match ? match.team_home : '' %>"
                    placeholder="e.g., Manang FC">
            </div>
            <div class="form-group">
                <label for="team_away">Away Team *</label>
                <input type="text" id="team_away" name="team_away" required value="<%= match ? match.team_away : '' %>"
                    placeholder="e.g., Three Star Club">
            </div>
        </div>

        <div class="form-row">
            <!-- Hidden Input for Backend (AD ISO String) -->
            <input type="hidden" id="match_date" name="match_date" required
                value="<%= match ? new Date(match.match_date).toISOString() : '' %>">

            <!-- Nepali Date Picker UI -->
            <div class="form-group">
                <label for="nepali_date">Match Date (BS) *</label>
                <input type="text" id="nepali_date" class="form-control" placeholder="Select Nepali Date" required
                    readonly style="background-color: rgba(255, 255, 255, 0.05); cursor: pointer;">
            </div>

            <div class="form-group">
                <label for="match_time">Time *</label>
                <input type="time" id="match_time" class="form-control" required style="color-scheme: dark;">
            </div>
        </div>

        <div class="form-group">
            <label for="venue">Venue *</label>
            <input type="text" id="venue" name="venue" required value="<%= match ? match.venue : '' %>"
                placeholder="e.g., Dasharath Stadium">
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="price">Ticket Price (Rs.) *</label>
                <input type="number" id="price" name="price" required min="0" step="0.01"
                    value="<%= match ? match.price : '500' %>">
            </div>
            <div class="form-group">
                <label for="total_seats">Total Seats *</label>
                <input type="number" id="total_seats" name="total_seats" required min="1"
                    value="<%= match ? match.total_seats : '1000' %>">
            </div>
        </div>

        <% if (isEdit) { %>
            <div class="form-group">
                <label>
                    <input type="checkbox" name="is_active" <%=match.is_active ? 'checked' : '' %>>
                    Match is active (visible to public)
                </label>
            </div>
            <% } %>

                <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
                    <button type="submit" class="btn-admin btn-admin-primary">
                        <%= isEdit ? 'Update Match' : 'Create Match' %>
                    </button>
                    <a href="/admin/matches" class="btn-admin btn-admin-secondary">Cancel</a>
                </div>
    </form>

    <%- include('footer') %>

        <!-- CSS -->
        <link
            href="https://nepalidatepicker.sajanmaharjan.com.np/v5/nepali.datepicker/css/nepali.datepicker.v5.0.6.min.css"
            rel="stylesheet" type="text/css" />

        <!-- JS -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script
            src="https://nepalidatepicker.sajanmaharjan.com.np/v5/nepali.datepicker/js/nepali.datepicker.v5.0.6.min.js"></script>

        <script>
            $(document).ready(function () {
                // Initialize Nepali Date Picker
                $('#nepali_date').nepaliDatePicker({
                    ndpYear: true,
                    ndpMonth: true,
                    ndpYearCount: 10,
                    onChange: updateHiddenDate
                });

                // Handle Time Change
                $('#match_time').on('change', updateHiddenDate);

                // Pre-fill logic for EDIT mode
                const existingDateVal = document.getElementById('match_date').value;
                if (existingDateVal) {
                    const dateObj = new Date(existingDateVal);

                    // 1. Set Time
                    const hours = dateObj.getHours().toString().padStart(2, '0');
                    const minutes = dateObj.getMinutes().toString().padStart(2, '0');
                    document.getElementById('match_time').value = `${hours}:${minutes}`;

                    // 2. Set Nepali Date (AD -> BS)
                    try {
                        const adDate = dateObj.toISOString().split('T')[0]; // YYYY-MM-DD
                        const bsDateObj = NepaliFunctions.AD2BS(NepaliFunctions.ParseDate(adDate));
                        const bsDateStr = `${bsDateObj.year}-${String(bsDateObj.month).padStart(2, '0')}-${String(bsDateObj.day).padStart(2, '0')}`;
                        $('#nepali_date').val(bsDateStr);
                    } catch (e) {
                        console.error("Date conversion error", e);
                    }
                }

                function updateHiddenDate() {
                    const bsDate = $('#nepali_date').val(); // 2082-01-05
                    const time = $('#match_time').val();    // 14:30

                    if (bsDate && time) {
                        try {
                            // BS -> AD
                            const adDateObj = NepaliFunctions.BS2AD(NepaliFunctions.ParseDate(bsDate));
                            const adDateStr = `${adDateObj.year}-${String(adDateObj.month).padStart(2, '0')}-${String(adDateObj.day).padStart(2, '0')}`;

                            // Combine -> ISO
                            const combinedDate = new Date(`${adDateStr}T${time}:00`);

                            document.getElementById('match_date').value = combinedDate.toISOString();
                        } catch (e) {
                            console.error("Update hidden date error", e);
                        }
                    }
                }
            });
        </script>