<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>
        <%= title %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Khand:wght@400;500;600;700&family=Mukta:wght@400;500;600;700;800&family=Oswald:wght@500;700&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --color-bg: #0a0a14;
            --color-card: #141428;
            --color-accent: #22c55e;
            --color-text: #ffffff;
            --color-text-muted: #9ca3af;
        }

        body {
            margin: 0;
            padding: 0;
            background: #0f172a;
            font-family: 'Mukta', sans-serif;
            color: var(--color-text);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .ticket-container {
            width: 100%;
            max-width: 380px;
            padding: 20px;
        }

        /* TICKET CARD */
        .ticket {
            background: linear-gradient(160deg, #1a1a2e 0%, #11111f 100%);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
        }

        /* HEADER */
        .ticket-header {
            background: linear-gradient(90deg, #064e3b 0%, #1a1a2e 100%);
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .organizer-logo {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: 2px solid var(--color-accent);
            object-fit: cover;
        }

        .organizer-info h3 {
            margin: 0;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--color-accent);
        }

        .organizer-info h2 {
            margin: 0;
            font-size: 0.9rem;
            font-weight: 700;
        }

        /* EVENT TITLE */
        .event-title {
            text-align: center;
            padding: 1.5rem 1rem 0;
        }

        .event-title h1 {
            font-family: 'Khand', sans-serif;
            text-transform: uppercase;
            font-size: 1.5rem;
            line-height: 1.1;
            margin: 0;
            background: linear-gradient(to right, #fff, #cbd5e1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .event-title span {
            display: block;
            font-size: 0.8rem;
            color: var(--color-accent);
            margin-top: 5px;
            letter-spacing: 2px;
            font-weight: 700;
        }

        /* MATCH DETAILS */
        .match-card {
            padding: 1.5rem;
        }

        .teams-vs {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            position: relative;
        }

        .teams-vs::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 1px;
            height: 40px;
            background: rgba(255, 255, 255, 0.1);
        }

        .team {
            width: 45%;
            text-align: center;
        }

        .team-name {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 5px;
            display: block;
        }

        .vs-badge {
            background: rgba(34, 197, 94, 0.1);
            color: var(--color-accent);
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 800;
        }

        /* QR CODE */
        .qr-section {
            display: flex;
            justify-content: center;
            margin-bottom: 2rem;
            position: relative;
        }

        .qr-wrapper {
            background: white;
            padding: 12px;
            border-radius: 16px;
            box-shadow: 0 0 20px rgba(34, 197, 94, 0.2);
        }

        .qr-wrapper img {
            display: block;
            width: 160px;
            height: 160px;
        }

        /* Neon corners */
        .qr-frame {
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 200px;
            height: 200px;
            border: 2px solid transparent;
            /* Using simple borders for now for compatibility */
            pointer-events: none;
        }

        /* INFO GRID */
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }

        .info-cell {
            text-align: center;
        }

        .info-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            color: var(--color-text-muted);
            margin-bottom: 4px;
            display: block;
        }

        .info-value {
            font-size: 0.85rem;
            font-weight: 600;
        }

        /* SPONSORS STRIP */
        .sponsors-footer {
            background: #ffffff;
            padding: 1rem;
            text-align: center;
        }

        .sponsors-title {
            color: #64748b;
            font-size: 0.6rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.75rem;
            font-weight: 700;
        }

        .sponsors-logos {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .sponsor-logo svg {
            height: 20px;
            width: auto;
            fill: #334155;
            display: block;
        }

        /* ACTIONS */
        .actions {
            margin-top: 1.5rem;
            text-align: center;
        }

        .btn {
            display: inline-block;
            background: var(--color-accent);
            color: #000;
            padding: 12px 24px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            width: 100%;
            box-sizing: border-box;
            border: none;
            cursor: pointer;
        }
    </style>
</head>

<body>
    <div class="ticket-container">

        <!-- SUCCESS STATUS -->
        <div style="text-align: center; margin-bottom: 1.5rem;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">✅</div>
            <h2 style="margin: 0; color: var(--color-accent);">टिकट सुनिश्चित भयो</h2>
            <p style="margin: 5px 0 0; color: var(--color-text-muted); font-size: 0.9rem;">रंगशालामा भेटौँला!</p>
        </div>

        <div class="ticket" id="ticket-card">
            <!-- HEADER -->
            <div class="ticket-header">
                <img src="/images/saubhagya-logo.jpg" alt="Organizer" class="organizer-logo">
                <div class="organizer-info">
                    <h3>आयोजक</h3>
                    <h2>सौभाग्य युवा क्लब</h2>
                </div>
            </div>

            <!-- TITLE -->
            <div class="event-title">
                <h1>दोस्रो प्रचण्ड थैव<br>स्मृति गोल्ड कप</h1>
                <span>२०८२</span>
            </div>

            <!-- MATCH BODY -->
            <div class="match-card">
                <!-- TEAMS -->
                <div class="teams-vs">
                    <div class="team">
                        <span class="team-name">
                            <%= ticket.team_home %>
                        </span>
                    </div>
                    <span class="vs-badge">VS</span>
                    <div class="team">
                        <span class="team-name">
                            <%= ticket.team_away %>
                        </span>
                    </div>
                </div>

                <!-- QR CODE SECTION -->
                <div class="qr-section">
                    <% if (ticket.status==='PAID' ) { %>
                        <!-- APPROVED: Show Real QR -->
                        <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                            <div class="qr-wrapper">
                                <div
                                    style="width: 160px; height: 160px; background: white; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                                    <div id="qrcode"></div>
                                </div>
                            </div>
                            <div style="text-align: center;">
                                <span
                                    style="background: rgba(34, 197, 94, 0.1); color: var(--color-accent); padding: 6px 12px; border-radius: 6px; font-family: 'Oswald', sans-serif; letter-spacing: 2px; font-size: 1.25rem; font-weight: 700; border: 1px solid rgba(34,197,94,0.4); display: inline-block;">
                                    <%= ticket.qr_code %>
                                </span>
                            </div>
                        </div>
                        <% } else { %>
                            <!-- PENDING: Show Placeholder -->
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
                                <div class="qr-wrapper" style="opacity: 0.7;">
                                    <div
                                        style="width: 160px; height: 160px; background: #fef3c7; display: flex; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; color: #d97706;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10" />
                                            <polyline points="12 6 12 12 16 14" />
                                        </svg>
                                        <span
                                            style="font-size: 0.8rem; font-weight: 700; margin-top: 8px; text-transform: uppercase;">पेन्डिङ</span>
                                    </div>
                                </div>
                                <div style="text-align: center;">
                                    <span class="pulse-badge"
                                        style="display: inline-block; background: rgba(251, 191, 36, 0.15); color: #fbbf24; font-size: 0.85rem; padding: 8px 16px; border-radius: 8px; border: 2px solid rgba(251,191,36,0.5); letter-spacing: 0.5px; font-weight: 700; animation: pulse-glow 2s ease-in-out infinite;">
                                        🔄 तपाईंको टिकट प्रमाणीकरण प्रक्रियामा छ
                                    </span>
                                    <style>
                                        @keyframes pulse-glow {

                                            0%,
                                            100% {
                                                box-shadow: 0 0 5px rgba(251, 191, 36, 0.3);
                                                transform: scale(1);
                                            }

                                            50% {
                                                box-shadow: 0 0 20px rgba(251, 191, 36, 0.6);
                                                transform: scale(1.02);
                                            }
                                        }
                                    </style>
                                </div>
                            </div>
                            <% } %>
                </div>

                <!-- DETAILS GRID -->
                <div class="info-grid">
                    <div class="info-cell">
                        <span class="info-label">मिति र समय</span>
                        <div class="info-value">
                            <%= formatDate(ticket.match_date) %>
                        </div>
                    </div>
                    <div class="info-cell">
                        <span class="info-label">स्थान</span>
                        <div class="info-value">
                            <%= ticket.venue %>
                        </div>
                    </div>
                    <div class="info-cell">
                        <span class="info-label">नाम</span>
                        <div class="info-value">
                            <%= ticket.user_name || 'Guest' %>
                        </div>
                    </div>
                    <div class="info-cell">
                        <span class="info-label">प्रकार</span>
                        <div class="info-value">साधारण प्रवेश</div>
                    </div>
                </div>

            </div>

            <!-- SPONSORS FOOTER (White Strip) -->
            <div class="sponsors-footer">
                <div class="sponsors-title">आधिकारिक साझेदारहरू</div>
                <div class="sponsors-logos">
                    <!-- NTC -->
                    <div class="sponsor-logo" title="Nepal Telecom">
                        <svg viewBox="0 0 100 40" width="60" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M10 20C10 14.4772 14.4772 10 20 10H80C85.5228 10 90 14.4772 90 20C90 25.5228 85.5228 30 80 30H20C14.4772 30 10 25.5228 10 20Z"
                                fill="#334155" fill-opacity="0.2" />
                            <text x="50" y="24" font-family="Arial" font-size="12" fill="#334155" text-anchor="middle"
                                font-weight="bold">NTC</text>
                        </svg>
                    </div>
                    <!-- eSewa -->
                    <div class="sponsor-logo" title="eSewa">
                        <svg viewBox="0 0 100 40" width="60" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M15 15H35V25H15V15Z" fill="#334155" />
                            <circle cx="50" cy="20" r="8" fill="#334155" fill-opacity="0.8" />
                            <rect x="65" y="12" width="20" height="16" rx="4" fill="#334155" fill-opacity="0.6" />
                        </svg>
                    </div>
                    <!-- WorldLink -->
                    <div class="sponsor-logo" title="WorldLink">
                        <svg viewBox="0 0 100 40" width="60" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M10 20L20 10L30 20L40 10L50 20" stroke="#334155" stroke-width="3"
                                stroke-linecap="round" stroke-linejoin="round" />
                            <text x="75" y="24" font-family="Arial" font-size="10" fill="#334155"
                                text-anchor="middle">WorldLink</text>
                        </svg>
                    </div>
                    <!-- Himalayan Bank -->
                    <div class="sponsor-logo" title="Himalayan Bank">
                        <svg viewBox="0 0 100 40" width="60" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="20" y="8" width="60" height="24" stroke="#334155" stroke-width="2" />
                            <path d="M20 8L50 32L80 8" stroke="#334155" stroke-width="2" fill="none" />
                        </svg>
                    </div>
                    <!-- Ruslan -->
                    <div class="sponsor-logo" title="Ruslan">
                        <svg viewBox="0 0 100 40" width="60" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <text x="50" y="26" font-family="Georgia" font-size="14" fill="#334155" text-anchor="middle"
                                font-style="italic">Ruslan</text>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="actions">
            <% if (ticket.status==='PAID' ) { %>
                <button class="btn" onclick="downloadTicket()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        style="vertical-align: middle; margin-right: 8px;">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="7 10 12 15 17 10" />
                        <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                    टिकट डाउनलोड गर्नुहोस्
                </button>
                <% } else { %>
                    <div
                        style="background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.3); padding: 1rem; border-radius: 12px; color: #fbbf24; font-size: 0.9rem; text-align: center;">
                        <strong>भुक्तानी रुजु हुँदैछ</strong>
                        <p style="margin: 5px 0 0; opacity: 0.8; font-size: 0.8rem;">एडमिनले भुक्तानी रुजु गरेपछि
                            तपाईंको टिकट डाउनलोड गर्न मिल्नेछ|</p>
                    </div>
                    <% } %>

                        <div style="margin-top: 1rem; text-align: center;">
                            <a href="/"
                                style="color: var(--color-text-muted); font-size: 0.9rem; text-decoration: none;">वेबसाइटमा
                                फर्कनुहोस्</a>
                        </div>
        </div>
    </div>

    <!-- QR Code Library + HTML2Canvas -->
    <% if (ticket.status==='PAID' ) { %>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
        <% } %>
            <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

            <script>
        <% if (ticket.status === 'PAID') { %>
                    // Generate QR Code only if PAID
                    new QRCode(document.getElementById("qrcode"), {
                        text: "<%= ticket.qr_code %>",
                        width: 160,
                        height: 160,
                        colorDark: "#000000",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.H
                    });
        <% } %>

                    // Download Function
                    function downloadTicket() {
                        const ticket = document.getElementById('ticket-card');
                        const btn = document.querySelector('.btn');

                        if (btn) btn.innerHTML = 'Generating...';

                        html2canvas(ticket, {
                            scale: 2,
                            backgroundColor: '#1a1a2e', // Force background color
                            useCORS: true,
                            onclone: (clonedDoc) => {
                                // Fix for invisible text due to background-clip: text not being supported by html2canvas
                                const title = clonedDoc.querySelector('.event-title h1');
                                if (title) {
                                    title.style.background = 'none';
                                    title.style.webkitTextFillColor = 'initial'; // Reset transparent text
                                    title.style.color = '#ffffff'; // Force white text
                                }
                            }
                        }).then(canvas => {
                            const link = document.createElement('a');
                            link.download = 'Prachanda-GoldCup-Ticket-<%= ticket.qr_code %>.png';
                            link.href = canvas.toDataURL();
                            link.click();
                            if (btn) btn.innerHTML = 'टिकट डाउनलोड गर्नुहोस्';
                        });
                    }
            </script>
</body>

</html>