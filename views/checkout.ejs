<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>
        <%= title %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Khand:wght@400;500;600;700&family=Mukta:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="app-container">
        <header class="header">
            <a href="/" class="logo"
                style="text-decoration: none; display: flex; align-items: center; width: 100%; justify-content: space-between;">
                <img src="/images/saubhagya-logo.jpg" alt="Logo"
                    style="height: 32px; width: 32px; border-radius: 50%; object-fit: cover;">
                <span class="logo-text"
                    style="color: #111827; text-transform: uppercase; font-weight: 800; letter-spacing: -0.5px; font-size: 0.9rem; text-align: right;">दोस्रो
                    प्रचण्ड थैव स्मृति गोल्ड कप २०८२</span>
            </a>
            <!-- Nav removed for checkout focus -->
        </header>

        <main class="main-content">
            <section class="checkout-section">
                <h1 class="checkout-title" style="font-family: 'Khand', sans-serif;">🎟️ टिकट खरिद गर्नुहोस्</h1>

                <div class="checkout-container">
                    <div class="match-summary">
                        <div class="match-teams-checkout">
                            <span class="team">
                                <%= match.team_home %>
                            </span>
                            <span class="vs">VS</span>
                            <span class="team">
                                <%= match.team_away %>
                            </span>
                        </div>

                        <div class="match-details">
                            <div class="detail-item">
                                <span class="detail-icon">📅</span>
                                <span>
                                    <%= formatDate(match.match_date) %>
                                </span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-icon">📍</span>
                                <span>
                                    <%= match.venue %>
                                </span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-icon">💺</span>
                                <span>
                                    <%= typeof formatSeats==='function' ? formatSeats(match.available_seats) :
                                        match.available_seats %> सिट उपलब्ध
                                </span>
                            </div>
                        </div>

                        <!-- Tribute Section (Phase 3) -->
                        <div
                            style="margin-bottom: 2rem; padding: 1rem; border-left: 3px solid #f59e0b; background: rgba(245, 158, 11, 0.1); border-radius: 0 8px 8px 0;">
                            <h4
                                style="color: #f59e0b; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem;">
                                प्रतियोगिता समर्पित</h4>
                            <ul
                                style="list-style: none; margin: 0; padding: 0; color: var(--color-text-secondary); font-size: 0.9rem;">
                                <li style="margin-bottom: 0.25rem;">⭐ <strong>स्वर्गीय प्रचण्ड थैव</strong></li>
                                <li style="margin-bottom: 0.25rem;">⭐ <strong>स्वर्गीय नवीन थापा</strong></li>
                                <li style="margin-bottom: 0.25rem;">⭐ <strong>स्वर्गीय विरेन्द्र जि.सी</strong></li>
                                <li style="margin-bottom: 0.25rem;">⭐ <strong>स्वर्गीय राज श्रेष्ठ</strong></li>
                                <li style="margin-bottom: 0.25rem;">⭐ <strong>स्वर्गीय गंगा ब. खत्री</strong></li>
                                <li>⭐ <strong>स्वर्गीय बसन्त गुरुङ</strong></li>
                            </ul>
                        </div>

                        <div class="price-display">
                            <span class="price-label">प्रति टिकट मूल्य</span>
                            <span class="price-amount">
                                <%= formatPrice(match.price) %>
                            </span>
                        </div>
                    </div>

                    <form action="/buy_ticket" method="POST" class="checkout-form">
                        <input type="hidden" name="match_id" value="<%= match.id %>">

                        <div class="form-group">
                            <label for="name">पूरा नाम *</label>
                            <input type="text" id="name" name="name" required placeholder="तपाईंको पूरा नाम"
                                autocomplete="name">
                        </div>

                        <div class="form-group">
                            <label for="phone">मोबाइल नम्बर *</label>
                            <input type="tel" id="phone" name="phone" required placeholder="९८XXXXXXXX"
                                pattern="[0-9]{10}" inputmode="numeric" autocomplete="tel">
                            <span class="form-hint">१० अंकको मोबाइल नम्बर</span>
                        </div>

                        <div class="form-group">
                            <label for="quantity">टिकट संख्या *</label>
                            <select id="quantity" name="quantity" required onchange="updateTotal()">
                                <% for(let i=1; i <=Math.min(10, match.available_seats); i++) { %>
                                    <option value="<%= i %>">
                                        <%= i %> टिकट
                                    </option>
                                    <% } %>
                            </select>
                        </div>

                        <div class="order-summary">
                            <div class="summary-row">
                                <span>जम्मा टिकट</span>
                                <span id="ticketCount">1</span>
                            </div>
                            <div class="summary-row">
                                <span>प्रति टिकट मूल्य</span>
                                <span id="pricePerTicket">
                                    <%= formatPrice(match.price) %>
                                </span>
                            </div>
                            <div class="summary-row total">
                                <span>जम्मा रकम</span>
                                <span id="totalAmount">
                                    <%= formatPrice(match.price) %>
                                </span>
                            </div>
                        </div>

                        <!-- Sticky footer on mobile -->
                        <div class="checkout-sticky-footer">
                            <div
                                style="background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3); padding: 0.75rem; border-radius: 8px; margin-bottom: 0.75rem; display: flex; align-items: flex-start; gap: 0.75rem;">
                                <span style="font-size: 1.25rem;">🛡️</span>
                                <div style="font-size: 0.75rem; color: var(--color-text-secondary); line-height: 1.3;">
                                    <strong
                                        style="color: var(--color-accent-green); display: block; margin-bottom: 0.1rem;">आधिकारिक
                                        भुक्तानी साझेदार</strong>
                                    रकम सुरक्षित रूपमा सिधै ट्रान्सफर हुनेछ: <strong>सौभाग्य युवा क्लब</strong> (आयोजक).
                                </div>
                            </div>
                            <button type="submit" class="btn btn-esewa btn-block">
                                <img src="https://esewa.com.np/common/images/esewa_logo.png" alt="eSewa"
                                    class="esewa-logo" onerror="this.style.display='none'">
                                eSewa मार्फत भुक्तानी गर्नुहोस्
                            </button>
                        </div>

                        <p class="checkout-note">
                            तपाईंलाई सुरक्षित भुक्तानीको लागि eSewa मा लगिनेछ
                        </p>
                    </form>
                </div>

                <a href="/" class="back-link">← खेलहरूमा फर्कनुहोस्</a>
            </section>
        </main>

        <footer class="footer">
            <p>© २०८२ दोस्रो प्रचण्ड थैव स्मृति गोल्ड कप. सर्वाधिकार सुरक्षित.</p>
        </footer>
    </div>

    <script>
        const ticketPrice = <%= match.price %>;

        function updateTotal() {
            const quantity = document.getElementById('quantity').value;
            const total = ticketPrice * quantity;
            document.getElementById('ticketCount').textContent = quantity;
            document.getElementById('totalAmount').textContent = 'रू ' + total.toLocaleString('ne-NP');
        }
    </script>
</body>

</html>