<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="GoalKick Lite - Buy football match tickets in Nepal with eSewa payment">
    <meta name="theme-color" content="#1a1a2e">
    <title>
        <%= title %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* Default Styles */
    </style>
</head>

<body>
    <div class="app-container">
        <!-- New "Smart" Header -->
        <header class="header">
            <!-- Mobile View (< 768px) -->
            <div class="header-mobile-view">
                <a href="/" class="logo" style="text-decoration: none; margin: 0 auto;">
                    <img src="/images/saubhagya-logo.jpg" alt="Logo"
                        style="height: 32px; width: 32px; border-radius: 50%; object-fit: cover; margin-right: 8px;">
                </a>
            </div>

            <!-- Desktop View (>= 768px) -->
            <div class="header-desktop-view">
                <!-- Title removed as it is in Hero Section -->
            </div>

            <div class="header-right">
                <div class="trust-badge">
                    <img src="/images/municipality-logo.jpg" alt="Butwal Municipality">
                    <div class="trust-text">
                        <small>सहयोग</small>
                        <span>बुटवल उप-महानगरपालिका</span>
                    </div>
                </div>
                <!-- Buy Ticket Button Removed -->
            </div>
    </div>
    </header>

    <main class="main-content">
        <style>
            .success-banner {
                background: linear-gradient(135deg, rgba(34, 197, 94, 0.2), rgba(16, 163, 74, 0.2));
                border: 1px solid rgba(34, 197, 94, 0.4);
                border-radius: 12px;
                padding: 1.5rem;
                margin-bottom: 1.5rem;
                text-align: center;
            }

            .success-banner-icon {
                font-size: 2.5rem;
                margin-bottom: 0.75rem;
            }

            .success-banner-title {
                font-size: 1.25rem;
                font-weight: 700;
                color: #4ade80;
                margin-bottom: 0.5rem;
            }

            .success-banner-text {
                color: #a0a0b0;
                font-size: 0.9rem;
                line-height: 1.6;
            }

            .success-banner-ref {
                font-family: monospace;
                background: rgba(255, 255, 255, 0.1);
                padding: 0.5rem 1rem;
                border-radius: 8px;
                display: inline-block;
                margin: 0.75rem 0;
                font-weight: 600;
            }
        </style>

        <!-- Success Banner Removed -->

        <section class="hero saubhagya-hero">
            <div class="hero-content">
                <div class="hero-badge">शहिद प्रचण्ड थैवको स्मृतिमा</div>
                <h1 class="hero-title">दोस्रो प्रचण्ड थैव<br><span class="text-gold">स्मृति गोल्ड कप २०८२</span>
                </h1>
                <p class="hero-subtitle">बुटवलको शान, फुटबलको गौरव।</p>

                <div class="hero-actions">
                    <a href="#matches" class="btn btn-primary btn-lg">टिकट किन्नुहोस्</a>
                    <a href="/find-ticket" class="btn btn-outline btn-lg"
                        style="margin-left: 10px; background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.3);">मेरो
                        टिकट खोज्नुहोस्</a>
                </div>

                <!-- Mobile Trust Row (Visible only on Mobile) -->
                <div class="trust-row-mobile">
                    <div class="trust-item">
                        <span>आयोजक</span>
                        <img src="/images/saubhagya-logo.jpg" alt="Club">
                        <small class="trust-name">सौभाग्य युवा क्लब</small>
                    </div>
                    <div class="divider-vertical"></div>
                    <div class="trust-item">
                        <span>सहयोग</span>
                        <img src="/images/municipality-logo.jpg" alt="Muni">
                        <small class="trust-name">बुटवल उप-महानगरपालिका</small>
                    </div>
                </div>
            </div>
        </section>

        <section class="matches-section" id="matches">
            <h2 class="section-title">आउँदो खेलहरू</h2>

            <% if (matches.length===0) { %>
                <div class="empty-state">
                    <span class="empty-icon">📅</span>
                    <h3>कुनै खेल उपलब्ध छैन</h3>
                    <p>कृपया पछि फेरि चेक गर्नुहोस्!</p>
                </div>
                <% } else { %>
                    <div class="matches-grid">
                        <% matches.forEach(match=> { %>
                            <div class="match-card">
                                <div class="match-date-badge">
                                    <%= formatDate(match.match_date) %>
                                </div>

                                <div class="match-teams">
                                    <span class="team home">
                                        <%= match.team_home %>
                                    </span>
                                    <span class="vs">VS</span>
                                    <span class="team away">
                                        <%= match.team_away %>
                                    </span>
                                </div>

                                <div class="match-venue">
                                    <span class="venue-icon">📍</span>
                                    <%= match.venue %>
                                </div>

                                <div class="match-info">
                                    <div class="info-item">
                                        <span class="info-label">मूल्य</span>
                                        <span class="info-value price">
                                            <%= formatPrice(match.price) %>
                                        </span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">बाँकी सिट</span>
                                        <span class="info-value seats <%= match.available_seats < 50 ? 'low' : '' %>">
                                            <%= match.available_seats %> / <%= match.total_seats %>
                                        </span>
                                    </div>
                                </div>

                                <% if (match.available_seats> 0) { %>
                                    <a href="/match/<%= match.id %>" class="btn btn-primary btn-block">
                                        🎟️ टिकट किन्नुहोस्
                                    </a>
                                    <% } else { %>
                                        <button class="btn btn-disabled btn-block" disabled>
                                            टिकट सकियो
                                        </button>
                                        <% } %>

                                            <!-- Trophy Sponsor Strip -->
                                            <div
                                                style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px dashed rgba(255,255,255,0.1); width: 100%; text-align: center;">
                                                <p
                                                    style="font-size: 0.7rem; color: #a0a0b0; margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">
                                                    🏆 ट्रफी प्रायोजक: <span
                                                        style="color: #fbbf24; font-weight: 600;">अमश
                                                        गुरुङ</span>
                                                </p>
                                            </div>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>
        </section>
    </main>

    <%- include('partials/sponsors-footer') %>

        <footer class="footer">
            <p>© २०८२ दोस्रो प्रचण्ड थैव स्मृति गोल्ड कप. सर्वाधिकार सुरक्षित.</p>
        </footer>
        </div>
        <!-- Verification Modal Removed -->


</body>

</html>